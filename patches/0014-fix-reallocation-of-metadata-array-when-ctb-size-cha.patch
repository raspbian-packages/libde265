From: Dirk Farin <dirk.farin@gmail.com>
Date: Sun, 15 Mar 2026 22:58:39 +0100
Subject: fix reallocation of metadata array when ctb size changes (thanks to
 Ana K.)

(cherry picked from commit c7891e412106130b83f8e8ea8b7f907e9449b658)
---
 libde265/image.cc | 5 +++--
 libde265/image.h  | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/libde265/image.cc b/libde265/image.cc
index 057705c..a376aaa 100644
--- a/libde265/image.cc
+++ b/libde265/image.cc
@@ -453,8 +453,9 @@ de265_error de265_image::alloc_image(int w,int h, enum de265_chroma c,
 
     // CTB info
 
-    if (ctb_info.width_in_units != sps->PicWidthInCtbsY ||
-        ctb_info.height_in_units != sps->PicHeightInCtbsY)
+    if (ctb_info.width_in_units  != sps->PicWidthInCtbsY  ||
+        ctb_info.height_in_units != sps->PicHeightInCtbsY ||
+        ctb_info.log2unitSize    != sps->Log2CtbSizeY)
       {
         delete[] ctb_progress;
 
diff --git a/libde265/image.h b/libde265/image.h
index 0a0c0e3..7908fe3 100644
--- a/libde265/image.h
+++ b/libde265/image.h
@@ -149,7 +149,7 @@ template <class DataUnit> class MetaDataArray
   // private:
   DataUnit* data;
   int data_size;
-  int log2unitSize;
+  uint8_t log2unitSize;
   int width_in_units;
   int height_in_units;
 };
